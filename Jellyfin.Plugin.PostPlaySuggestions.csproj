<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.PostPlaySuggestions</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.PostPlaySuggestions</AssemblyName>
    <Version>0.5.0.0</Version>
    <AssemblyVersion>0.5.0.0</AssemblyVersion>
    <FileVersion>0.5.0.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.4.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="12.4.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\configPage.html" LogicalName="Jellyfin.Plugin.PostPlaySuggestions.Web.configPage.html" />
    <EmbeddedResource Include="Web\postplay-suggestions.js" LogicalName="Jellyfin.Plugin.PostPlaySuggestions.Web.postplay-suggestions.js" />
    <EmbeddedResource Include="Web\postplay-suggestions.css" LogicalName="Jellyfin.Plugin.PostPlaySuggestions.Web.postplay-suggestions.css" />
  </ItemGroup>

</Project>
